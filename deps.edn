;; No dependencies.
;;
;; Not even a hash: there is no keccak here, so there is no `function-selector`
;; — see `ethereum.abi`'s docstring for why that is deliberate rather than
;; missing. Argument encoding is pure byte arithmetic over decimal strings,
;; and the only platform-specific part is the 32-byte word, which is confined
;; to `ethereum.abi.word`.
{:paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
